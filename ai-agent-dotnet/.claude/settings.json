{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(dotnet restore *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test --project tests/DocumentStorage.UnitTests *)",
      "Bash(npm ci)",
      "Bash(npx --no envilder validate --offline *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(npx --no envilder exec *)",
      "Bash(npm run test:integration *)",
      "Bash(dotnet test --project tests/DocumentStorage.IntegrationTests *)",
      "Edit(./envilder.json)",
      "Edit(./.claude/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(aws *)",
      "Bash(npx envilder *)",
      "Bash(npx --no envilder --push *)",
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": ["api.nuget.org", "registry.npmjs.org"],
      "strictAllowlist": true
    }
  }
}
