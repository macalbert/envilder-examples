<Project>

  <!-- Every NuGet version for the .NET examples lives here. Update with: dotnet outdated envilder-examples.slnx -u -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the Amazon.CDK.Lib entry below override the vulnerable version LocalStack.Aspire.Hosting pulls in -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.4" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="AWSSDK.SimpleSystemsManagement" Version="4.0.103.9" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageVersion Include="Amazon.CDK.Lib" Version="2.271.0" />
    <PackageVersion Include="Envilder" Version="0.5.1" />
    <PackageVersion Include="LocalStack.Aspire.Hosting" Version="13.4.0" />
    <PackageVersion Include="Testcontainers.LocalStack" Version="4.15.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
