<!-- Aspire.AppHost.Sdk version is pinned in global.json (msbuild-sdks) -->
<Project Sdk="Aspire.AppHost.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Keep NuGet-restored DCP/dashboard so `dotnet test` works without the Aspire CLI -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Envilder" />
    <PackageReference Include="LocalStack.Aspire.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../envilder.json" Link="envilder.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
